# Local development only. NEVER commit a filled-in copy. Copy to .env and fill in.
# In the Foundry-hosted container, FOUNDRY_PROJECT_ENDPOINT and APPLICATIONINSIGHTS_CONNECTION_STRING
# are injected automatically by the platform - do NOT set them here for production.

# --- Foundry project (local dev) ---
# Format: https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployment the harness agent uses. Both names are set for compatibility:
#   - MODEL_DEPLOYMENT_NAME is the Foundry-docs convention (declared in azure.yaml env map)
#   - FOUNDRY_MODEL is what FoundryChatClient reads from the environment
MODEL_DEPLOYMENT_NAME=<your-model-deployment>
FOUNDRY_MODEL=<your-model-deployment>

# --- Databricks Genie (managed MCP) ---
DATABRICKS_WORKSPACE_URL=https://<workspace-host>.azuredatabricks.net
# Set after the Genie space is created (see scripts/genie_space_setup.md). Managed MCP URL is derived from these.
DATABRICKS_GENIE_SPACE_ID=
# Name of the Foundry project connection that fronts the Databricks Genie MCP server
# (OAuth identity passthrough).
DATABRICKS_MCP_CONNECTION_NAME=databricks-genie-mcp

# Unity Catalog target used for sample data / context.
UC_CATALOG=<your_catalog>
UC_SCHEMA=default
# Serverless SQL Warehouse created by scripts/databricks_setup.py (needed for the Genie space).
DATABRICKS_WAREHOUSE_ID=<your-warehouse-id>
